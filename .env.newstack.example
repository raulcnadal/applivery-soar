# Environment for docker-compose.newstack.yml (BlueSky-stack rewrite).
# Copy to .env.newstack and fill in real values before `docker compose
# -f docker-compose.newstack.yml up --build`.

DASHBOARD_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
APPLIVERY_API_URL=https://api.applivery.io/v1

# Optional — Applivery's own documented ceiling is 10,000 requests/hour
# with burst capability (docs.applivery.com). Override only if your org's
# actual plan/contract grants a different limit.
APPLIVERY_RATE_LIMIT_PER_HOUR=10000
APPLIVERY_RATE_LIMIT_BURST=100

TRIGGER_SECRET=
CORS_ORIGINS=*

# Optional — set this (docker-compose.newstack.yml provisions a redis
# service) to run background jobs cluster-safe via BullMQ instead of
# in-process setInterval loops. Only matters if you run soar-app at more
# than one replica.
REDIS_URL=redis://soar-redis:6379
