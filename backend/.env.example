NODE_ENV=development
PORT=8000

# Required — process refuses to start without it (mirrors DASHBOARD_SECRET).
DASHBOARD_SECRET=change-me-to-a-long-random-string

# Required — Postgres connection string.
DATABASE_URL=postgresql://soar:soar@localhost:5432/soar?schema=public

APPLIVERY_API_URL=https://api.applivery.io/v1

# Optional — Applivery's own documented ceiling is 10,000 requests/hour
# with burst capability (docs.applivery.com). Override only if your org's
# actual plan/contract grants a different limit.
APPLIVERY_RATE_LIMIT_PER_HOUR=10000
APPLIVERY_RATE_LIMIT_BURST=100

# Optional — separate secret gating /api/compliance/evaluate-due and
# /api/workflows/resume-due for deployments that prefer an outside cron to
# drive those instead of relying on this container's own background loops.
TRIGGER_SECRET=

# Optional — when set, background jobs run as BullMQ repeatable jobs backed
# by this Redis instance instead of in-process setInterval loops, so exactly
# one instance of each job runs cluster-wide even with multiple backend
# replicas. Leave unset for a single-replica deployment; no extra
# infrastructure needed in that case.
REDIS_URL=

CORS_ORIGINS=*
