}

// Admin-defined custom device checks — disclosed new feature (no main.py
// equivalent), see customChecks.service.ts's module doc for the full design.
// One row per check; `key` is the stable identifier a Compliance Policy
// condition references (COMPLIANCE_FIELDS' "customCheckResult" field),
// scoped to one platform since a Windows registry check and a macOS plist
// check are never the same query. `params` shape depends on `checkerType`
// + `platform` together (validated in customChecks.service.ts, not at the
// Prisma layer — same "loose Json, app-code-validated" convention as
// CompliancePolicy.conditions).
model CustomCheckDefinition {
  id            String   @id @default(uuid())
  workspaceSlug String
  platform      String   // "windows" | "macos" | "ios" | "android" — see customChecks.schemas.ts CHECK_PLATFORMS
  key           String   // stable slug, unique per (workspaceSlug, platform)
  name          String
  description   String?
  checkerType   String   // "processRunning" | "serviceStatus" | "registryOrFileValue" | "appInstalled" | "command" — ios/android: appInstalled only, see MOBILE_CHECK_PLATFORMS
  params        Json
  enabled       Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, platform, key])
  @@index([workspaceSlug])
}

// Admin-defined event-driven detection watches — see
// backend/docs/event-driven-agent-detection-roadmap.md for the full design.
// Same "admin authors in Settings, agent polls read-only" shape as
// CustomCheckDefinition just above (loose Json `params`, app-code-validated
// in eventWatches.schemas.ts, not at the Prisma layer), and deliberately
// colocated near it since the two features share an agent poll cycle and a
// Settings page. `watchType` is the OS-native mechanism the agent uses to
// detect the change ("registryKey" — RegNotifyChangeKeyValue against an
// admin-specified key; "etwProvider" — a real-time ETW session scoped to one
// provider, e.g. Microsoft-Windows-Kernel-Process for process start/stop).
// `action`
// is what SOAR does when the agent's own local debounce (params.debounceMs)
// goes quiet and it calls POST /api/device-data/event-notify — either a
// targeted refresh of just that device's installed-apps inventory
// ("refreshInstalledApps") or an immediate compliance re-evaluation
// ("evaluateComplianceNow", reusing forceEvaluateNow's existing per-workspace
// cooldown). This action is stored per-watch, not inferred from watchKey
// string-matching, specifically so a new watch is fully usable from Settings
// alone — no backend code change needed to route it correctly.
model EventWatchDefinition {
  id            String   @id @default(uuid())
  workspaceSlug String
  platform      String   // "windows" | "macos"
  key           String   // stable slug, unique per (workspaceSlug, platform)
  name          String
  description   String?
  watchType     String   // "registryKey" | "etwProvider" (windows) | "fsEventsPath" | "launchdJobState" (macos)
  params        Json     // shape depends on watchType — see eventWatches.schemas.ts
  debounceMs    Int      @default(5000)
  action        String   // "refreshInstalledApps" | "evaluateComplianceNow"
  enabled       Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, platform, key])
  @@index([workspaceSlug])
}

