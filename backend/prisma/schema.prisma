// Applivery SOAR — BlueSky stack Prisma schema.
// Source of truth: /migration-plan.md §3. Every model here maps onto one of
// the 39 persisted store "kinds" in the original FastAPI app (see
// migration-plan.md §7.1 for the full traceability list) or a durable-workflow
// table that's new (previously handled by an optional side Postgres instance).
//
// Tenancy: `workspaceSlug` is a plain column (not a separate schema-per-tenant)
// on every tenant-scoped model, replacing the original "one SQLite file per
// workspace slug" design now that everything lives in one Postgres instance.
// Models with no `workspaceSlug` are intentionally global (shared catalogs
// refreshed once for every workspace, mirroring the original app's "_global"
// pseudo-slug).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────────────────────────────────────────
// Auth / RBAC — no local user table (every "user" is an Applivery
// Collaborator); Role is the only thing we persist ourselves.
// ────────────────────────────────────────────────────────────────

model Role {
  id                 String   @id @default(uuid())
  workspaceSlug      String
  name               String
  description        String?
  featureAccess      Json // { devices: "none"|"read"|"manage", ... }
  riskyActions       Json // { canDeletePolicyOrWorkflow: bool, ... }
  appliveryTagValues String[]
  segmentIds         String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceSlug])
}

model AutomationCredential {
  workspaceSlug        String    @id
  apiToken             String // encrypted at rest
  refreshToken         String // encrypted at rest
  apiTokenExpireAt     DateTime?
  refreshTokenExpireAt DateTime?
  configuredBy         String?
  configuredAt         DateTime?
  lastRefreshedAt      DateTime?
  updatedAt            DateTime  @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Workspace-level settings/state (today's single "state" JSON blob)
// ────────────────────────────────────────────────────────────────

model WorkspaceState {
  workspaceSlug                     String   @id
  themeMode                         String?
  webhookUrl                        String?
  smtpConfig                        Json?
  scheduledReports                  Json?
  timezone                          String?
  customReportTemplate              String?  @db.Text
  auditLogRetentionDays             Int?
  sessionTimeoutMinutes             Int?
  installedAppsRefreshBudgetPerHour Int?
  updatedAt                         DateTime @updatedAt
}

model WidgetLayout {
  id            String   @id @default(uuid())
  workspaceSlug String
  userEmail     String
  layout        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, userEmail])
}

// ────────────────────────────────────────────────────────────────
// Compliance engine
// ────────────────────────────────────────────────────────────────

model CompliancePolicy {
  id                          String    @id @default(uuid())
  workspaceSlug               String
  name                        String
  description                 String?
  enabled                     Boolean   @default(true)
  autoRun                     Boolean   @default(false)
  severity                    String    @default("medium")
  conditionLogic               String    @default("any")
  conditions                  Json
  workflowId                  String?
  nonComplianceTag             String?
  nonComplianceSmartAttributeId String?
  openCaseOnViolation          Boolean   @default(true)
  autoResolveCaseOnRecovery     Boolean   @default(false)
  mitreTechniques              String[]
  framework                   String?
  controlRef                  String?
  targetDeviceAudienceId        String?
  evaluationIntervalMinutes    Int       @default(60)
  autoRunBatchCap              Int?      @default(15)
  autoRunDestructiveAck         Boolean   @default(false)
  escalatedWorkflowId          String?
  escalatedWorkflowMinRiskTier  String    @default("high")
  // Scheduler/circuit-breaker state — not part of the save payload, managed
  // by the evaluation engine itself (see CompliancePolicyPayload comments
  // in compliance.schemas.ts). An explicit save resets the trip, same as
  // the original's update_compliance_policy.
  lastEvaluatedAt              DateTime?
  autoRunTripped               Boolean   @default(false)
  autoRunTrippedAt             DateTime?
  autoRunTrippedReason         String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  violations ComplianceViolation[]

  @@index([workspaceSlug])
}

model ComplianceViolation {
  id                String    @id @default(uuid())
  workspaceSlug     String
  policyId          String
  policy            CompliancePolicy @relation(fields: [policyId], references: [id])
  policyName        String?
  workflowId        String?
  workflowName      String?
  workflowRunId     String?
  escalated         Boolean   @default(false)
  deviceId          String
  deviceName        String?
  platform          String?
  platformDeviceId  String?
  matchedConditions Json?
  caseId            String?
  status            String
  severity          String    @default("medium")
  detectedAt        DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([workspaceSlug, policyId])
  @@index([workspaceSlug, status])
}

// Port of `_load_policy_quarantine`/`_save_policy_quarantine`'s per-workspace
// dict, keyed by deviceId -> {platform, policies, snapshotAt, workflowId}
// (main.py:6653 `_snapshot_policies_if_needed`). One row per (workspaceSlug,
// deviceId) — a later escalation tier touching an already-quarantined device
// must never clobber the original pre-quarantine baseline, so writes are a
// create-if-absent, not an upsert-overwrite.
model PolicyQuarantineEntry {
  id            String   @id @default(uuid())
  workspaceSlug String
  deviceId      String
  platform      String?
  policies      Json // snapshot of activePolicies at quarantine time — [{id, name, ...}]
  workflowId    String?
  snapshotAt    DateTime @default(now())

  @@unique([workspaceSlug, deviceId])
}

// Per-workspace suppression map — port of the original's `_compliance_state`
// JSON file. Keyed `"{policyId}:{deviceId}"` -> {violationId, status,
// lastDetectedAt}; a key's presence is what stops a still-violating
// device/policy pair from spawning a duplicate violation record on every
// evaluation pass. Cleared only on recovery (see compliance.service.ts),
// NOT by approving/dismissing a violation — matches the original's
// behavior of the two being fully independent (state suppresses;
// violation.status just reflects triage).
model ComplianceEvaluationState {
  workspaceSlug String @id
  state         Json   @default("{}")
}

// ────────────────────────────────────────────────────────────────
// Workflows — two execution engines, same schema
// ────────────────────────────────────────────────────────────────

model Workflow {
  id                         String   @id @default(uuid())
  workspaceSlug              String
  name                       String
  description                String?
  steps                      Json
  targetPlatform             String?
  targetDeploymentModel      String?
  recovery                   Json
  allowUnattendedDestructive Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  versions WorkflowVersion[]

  @@index([workspaceSlug])
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reason     String // 'update' | 'restore'
  createdBy  String?
  snapshot   Json // { name, description, steps, targetPlatform, targetDeploymentModel, recovery }
  createdAt  DateTime @default(now())

  @@index([workflowId])
}

model WorkflowRun {
  id                String    @id @default(uuid())
  workspaceSlug     String
  workflowId        String
  // `workflowName`/`total` are set at launch time for BOTH engines (Phase 4b
  // addition); `log` is only populated once the run is fully done — a live
  // "waiting"/"running" durable run is instead reconstructed on read from
  // the `results` relation (see workflows.service.ts's runView-equivalent,
  // porting main.py's `_pg_run_view`). This keeps the pre-existing in-memory
  // engine's write-once-at-completion behavior (Phase 4a) completely
  // unchanged: it still just writes `log` once and never touches
  // total/workflowName in the meantime.
  workflowName      String?
  targetDescription String?
  status            String
  total             Int?
  log               Json?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  pendingSteps WorkflowPendingStep[]
  results      WorkflowRunResult[]

  @@index([workspaceSlug, workflowId])
}

/**
 * Port of Postgres table `workflow_pending_steps` (main.py:501-536) — one row
 * per device currently parked in a 'wait' or 'run_script_wait' step, with
 * everything needed to resume it. `stepKind` 'timer' is a plain 'wait'
 * (resumeAt is exactly when to fire, always down nextStepId). 'script' is a
 * 'run_script_wait' (resumeAt is a TIMEOUT safety net — the fast path is
 * script_log_reconciler_loop resolving `pendingToken` early and deleting this
 * row itself; if the timer-based resumer claims a 'script' row instead, that
 * always means "timed out", so it follows onFailureStepId, never nextStepId).
 */
model WorkflowPendingStep {
  id              String    @id @default(uuid())
  runId           String
  run             WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceSnapshot  Json
  workflowId      String
  slugKey         String
  nextStepId      String
  log             Json
  resumeAt        DateTime
  stepKind        String    @default("timer") // 'timer' | 'script'
  onFailureStepId String?
  pendingToken    String?   @unique
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([resumeAt])
  @@index([runId])
}

/**
 * Port of Postgres table `workflow_run_results` (main.py:488-499) — one row
 * PER DEVICE in a run (not per-step; `steps` holds that device's full log so
 * far as one JSON array), upserted via ON CONFLICT (runId, deviceId). `status`
 * is 'waiting' | 'done'; `finalStatus` ('success'|'partial'|'failed') is only
 * set once `status` is 'done'.
 */
model WorkflowRunResult {
  id          String   @id @default(uuid())
  runId       String
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceName  String?
  steps       Json
  status      String // 'waiting' | 'done'
  finalStatus String?
  updatedAt   DateTime @updatedAt

  @@unique([runId, deviceId])
  @@index([runId])
}

// ────────────────────────────────────────────────────────────────
// Triggers, Cases, Case automation
// ────────────────────────────────────────────────────────────────

model Trigger {
  id                String    @id @default(uuid())
  workspaceSlug     String
  name              String
  description       String?
  workflowId        String
  enabled           Boolean   @default(true)
  openCase          Boolean   @default(false)
  caseSeverity      String    @default("medium")
  deviceLookupField String?
  secret            String
  lastFiredAt       DateTime?
  fireCount         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceSlug])
}

// The incident layer above raw Compliance Violations — port of main.py's
// CASE MANAGEMENT section (main.py:11779-12360ish). A Case survives across
// repeated detections of the same underlying problem and carries its own
// investigative status independent of whether remediation already ran.
// Three sources: 'compliance_violation' (auto-opened by
// upsertCaseForViolation), 'workflow_trigger' (opened by fireTrigger when
// openCase=true), 'manual' (POST /api/cases).
model Case {
  id             String  @id @default(uuid())
  workspaceSlug  String
  title          String
  status         String  @default("open") // open | investigating | resolved | closed | false_positive
  severity       String  @default("medium")
  source         String // compliance_violation | workflow_trigger | manual
  deviceId       String?
  deviceName     String?
  segmentId      String?
  policyId       String?
  policyName     String?
  violationIds   String[] @default([])
  workflowRunIds String[] @default([])
  assignee       String?
  createdBy      String?
  closedAt       DateTime?
  // SLA tracking — see CaseSlaSettings/_case_sla_status. acknowledgedAt is
  // set the first time a case gets an assignee OR moves to 'investigating'.
  // slaClockStartedAt anchors the SLA window and resets on every reopen
  // (recurrence is a fresh incident from an SLA standpoint); createdAt never
  // changes, preserving the case's original open date for history.
  acknowledgedAt             DateTime?
  slaClockStartedAt          DateTime  @default(now())
  slaAckBreachNotifiedAt     DateTime?
  slaResolveBreachNotifiedAt DateTime?
  mitreTechniques String[] @default([])
  // Threat intel lookups run against IOCs on this case (see
  // POST /api/cases/{id}/enrich) — array of {id,ioc,iocType,provider,
  // providerType,verdict,score,detail,link,checkedAt,checkedBy,cached}.
  threatIntel Json @default("[]")
  // Ticket links created by Integrations dispatch — array of
  // {type,id,url,sysId?,remoteStatus?,remoteResolved?,remoteStatusCheckedAt?,remoteStatusError?}.
  externalRefs Json @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes    CaseNote[]
  timeline CaseTimelineEntry[]

  @@index([workspaceSlug, status])
  @@index([workspaceSlug, policyId, deviceId])
}

model CaseNote {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorEmail String?
  text        String   @db.Text
  createdAt   DateTime @default(now())

  @@index([caseId])
}

// Port of `_case_timeline_entry` (main.py:11816) — one row per timeline
// event instead of a JSON array field, so a case with a long history doesn't
// require rewriting its entire timeline blob on every single append.
model CaseTimelineEntry {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String // created | status_changed | severity_changed | note_added | violation_linked | workflow_run_linked | assigned | reopened | device_recovered | sla_breached
  message   String   @db.Text
  actor     String?
  createdAt DateTime @default(now())

  @@index([caseId])
}

// Closes the gap that manually-created Cases had no unattended auto-fire
// path (unlike Compliance Policy autoRun and Inbound Triggers). Evaluated
// once, at creation time only. Port of main.py:12461-12651.
model CaseAutoRunRule {
  id                    String   @id @default(uuid())
  workspaceSlug         String
  name                  String
  enabled               Boolean  @default(true)
  minSeverity           String   @default("high")
  mitreTechniques       String[] @default([])
  workflowId            String
  autoRunDestructiveAck Boolean  @default(false)
  maxFiresPerHour       Int      @default(10)
  // Rolling 1-hour rate-limit window — array of ISO timestamps, capped to
  // the last 200 on write. Port of `rule.recentFires`.
  recentFires Json @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceSlug])
}

model CaseSlaSettings {
  workspaceSlug  String   @id
  enabled        Boolean  @default(true)
  notifyOnBreach Boolean  @default(true)
  thresholds     Json
  updatedAt      DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Integrations, Threat Intel, Applivery inbound webhook
// ────────────────────────────────────────────────────────────────

// Port of main.py:13275-13413 (IntegrationPayload/CRUD). config's secret
// sub-field(s) (webhookUrl/url/apiToken/password/routingKey/apiKey,
// depending on `type`) are Fernet-encrypted at rest by integrations.service.ts,
// mirroring _encrypt_integration_config/_decrypt_integration_config.
model Integration {
  id                           String    @id @default(uuid())
  workspaceSlug                String
  name                         String
  type                         String // slack | teams | discord | jira | servicenow | generic_webhook | pagerduty | opsgenie
  enabled                      Boolean   @default(true)
  notifyOnOpen                 Boolean   @default(true)
  notifyOnClose                Boolean   @default(false)
  minSeverity                  String    @default("low")
  autoCloseCaseOnRemoteResolve Boolean   @default(false)
  notifyOnSystemHealth         Boolean   @default(false)
  config                       Json
  createdBy                    String?
  lastFiredAt                  DateTime?
  fireCount                    Int       @default(0)
  lastError                    String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([workspaceSlug])
}

// Port of main.py:13965-14000 (ThreatIntelProviderPayload/CRUD). config's
// apiKey (virustotal/abuseipdb/hibp only — generic_rest has no single secret
// field) is Fernet-encrypted at rest, mirroring _encrypt_threat_intel_config.
model ThreatIntelProvider {
  id            String   @id @default(uuid())
  workspaceSlug String
  name          String
  type          String // virustotal | abuseipdb | hibp | generic_rest
  enabled       Boolean  @default(true)
  config        Json
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug])
}

model ThreatIntelCache {
  id           String   @id @default(uuid())
  workspaceSlug String
  ioc          String
  providerType String
  result       Json
  cachedAt     DateTime @default(now())
  expiresAt    DateTime

  @@unique([workspaceSlug, ioc, providerType])
}

model AppliveryWebhookConfig {
  workspaceSlug String   @id
  enabled       Boolean  @default(true)
  secret        String
  updatedAt     DateTime @updatedAt

  rules AppliveryWebhookRule[]
}

model AppliveryWebhookRule {
  id                    String  @id @default(uuid())
  workspaceSlug         String
  actionKey             String
  label                 String?
  enabled               Boolean @default(false)
  openCase              Boolean @default(false)
  caseSeverity          String  @default("medium")
  runWorkflow           Boolean @default(false)
  workflowId            String?
  autoRunDestructiveAck Boolean @default(false)

  workspace AppliveryWebhookConfig @relation(fields: [workspaceSlug], references: [workspaceSlug])

  @@unique([workspaceSlug, actionKey])
}

// ────────────────────────────────────────────────────────────────
// Device/MDM operational data
// ────────────────────────────────────────────────────────────────

model DeviceAudience {
  id            String   @id @default(uuid())
  workspaceSlug String
  name          String
  description   String?
  selectors     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug])
}

model DevicePushData {
  id            String   @id @default(uuid())
  workspaceSlug String
  deviceId      String
  kind          String
  payload       Json
  reportedAt    DateTime
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, deviceId])
}

model InstalledAppInventory {
  id            String   @id @default(uuid())
  workspaceSlug String
  deviceId      String
  apps          Json
  agentVersion  String?
  reportedAt    DateTime
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, deviceId])
}

model PendingAppReport {
  id            String   @id @default(uuid())
  workspaceSlug String
  deviceId      String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([workspaceSlug])
}

model DeviceReportSecret {
  workspaceSlug String   @id
  secret        String // encrypted at rest (secretCipher) — see settings/deviceReportSecret.service.ts
  rotatedBy     String?
  updatedAt     DateTime @updatedAt
}

/**
 * Port of the `script_run_tracking/{slug}.json` dict-of-entries store
 * (main.py:8891-8907) — one row per in-flight script dispatch, deleted the
 * moment script_log_reconciler_loop resolves it (success/failure/give-up) or
 * (for a `run_script_wait` dispatch) the durable engine's resumer claims it
 * via `workflowResume.pendingToken` first. `baselineSuccess`/`baselineError`
 * are the script's rolling success/error counts on Applivery's
 * script-logs/summary endpoint AT DISPATCH TIME — the reconciler diffs
 * against these since that endpoint only exposes rolling totals, never "just
 * the latest run". `workflowResume` is set only when this dispatch came from
 * a workflow's 'run_script_wait' step (as opposed to a plain 'Run script'
 * mdm_action or a manual dispatch) — `{pendingToken, slugKey}`.
 */
model ScriptRunTracking {
  id               String    @id @default(uuid())
  workspaceSlug    String
  deviceId         String
  deviceName       String?
  platformPath     String
  platformDeviceId String
  assetId          String
  scriptName       String?
  dispatchedAt     DateTime  @default(now())
  baselineSuccess  Int       @default(0)
  baselineError    Int       @default(0)
  attempts         Int       @default(0)
  workflowResume   Json?

  @@index([workspaceSlug])
}

model FirewallRuleSet {
  id                    String   @id @default(uuid())
  workspaceSlug         String
  name                  String
  description           String?
  ensureFirewallEnabled Boolean  @default(true)
  defaultInboundAction  String   @default("notConfigured")
  defaultOutboundAction String   @default("notConfigured")
  rules                 Json
  // Auto-provisioned Action Library script entry ids (Phase 4b builds the
  // provisioning flow itself) that the Workflow engine's applyFirewallRuleSet/
  // restoreFirewallRuleSet MDM actions delegate to via 'runScript' — see
  // main.py's "FIREWALL RULE SETS" section. Null until provisioned.
  applyLibraryId        String?
  restoreLibraryId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([workspaceSlug])
}

model FirewallRemediationState {
  id            String   @id @default(uuid())
  workspaceSlug String
  deviceId      String
  rulesetId     String
  appliedState  Json
  appliedAt     DateTime @default(now())

  @@unique([workspaceSlug, deviceId, rulesetId])
}

// ────────────────────────────────────────────────────────────────
// Action library, script repos, app catalog/lists
// ────────────────────────────────────────────────────────────────

model ActionLibraryEntry {
  id            String   @id @default(uuid())
  workspaceSlug String
  type          String
  name          String
  description   String?
  platform      String
  assetId       String?
  assetName     String?
  arguments     String?
  scope         String?  @default("machine")
  path          String?
  action        String?
  format        String?
  value         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug])
}

model ScriptRepo {
  id            String   @id @default(uuid())
  workspaceSlug String
  name          String
  owner         String
  repo          String
  branch        String   @default("main")
  path          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug])
}

model AppCatalogEntry {
  id            String   @id @default(uuid())
  workspaceSlug String
  platform      String
  identifier    String
  name          String?
  iconUrl       String?
  source        String   @default("manual")
  createdAt     DateTime @default(now())

  @@unique([workspaceSlug, platform, identifier])
}

model AppList {
  id            String   @id @default(uuid())
  workspaceSlug String
  name          String
  description   String?
  platform      String
  appIds        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceSlug])
}

// ────────────────────────────────────────────────────────────────
// Vulnerability Service (opt-in) + shared global catalogs
// ────────────────────────────────────────────────────────────────

model VulnServiceConfig {
  workspaceSlug        String    @id
  enabled              Boolean   @default(false)
  baseUrl              String    @default("")
  apiTokenEncrypted    String?
  refreshIntervalHours Int       @default(6)
  lastRefreshAt        DateTime?
  lastRefreshError     String?
  lastRefreshStats     Json?
  updatedAt            DateTime  @updatedAt
}

model VulnServiceCache {
  id            String   @id @default(uuid())
  workspaceSlug String
  key           String
  result        Json
  cachedAt      DateTime @default(now())

  @@unique([workspaceSlug, key])
}

model GlobalCatalog {
  source          String   @id
  payload         Json
  lastRefreshedAt DateTime @default(now())
}

model LocationCache {
  key      String   @id
  payload  Json
  cachedAt DateTime @default(now())
}

model AnalyticsSnapshot {
  id            String   @id @default(uuid())
  workspaceSlug String
  source        String
  date          String
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([workspaceSlug, date, source])
}

// ────────────────────────────────────────────────────────────────
// Audit logging, log export, system health, config export
// ────────────────────────────────────────────────────────────────

model AuditLogEntry {
  id            String   @id @default(uuid())
  workspaceSlug String
  category      String
  action        String
  actor         String
  targetType    String?
  targetId      String?
  targetName    String?
  message       String   @db.Text
  severity      String   @default("info")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, createdAt])
}

model LogExportDestination {
  id              String    @id @default(uuid())
  workspaceSlug   String
  type            String
  name            String
  enabled         Boolean   @default(true)
  format          String    @default("json")
  config          Json // secret sub-fields (secretAccessKey/password/privateKeyPassphrase) encrypted at rest — see logExportDestinations.service.ts
  createdBy       String?
  // Batch types only (s3/nfs/sftp) — cursor + last-failure tracking for
  // log_export_scheduler_loop's once-a-day ship. Real-time types
  // (syslog/webhook) never touch these, they fire inline per audit write.
  lastExportedAt  DateTime?
  lastExportError String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceSlug])
}

model SystemHealthJob {
  jobKey            String    @id
  status            String
  detail            String?
  lastHeartbeatAt   DateTime  @default(now())
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  consecutiveErrors Int       @default(0)
  lastAlertSentAt   DateTime? // non-null == already alerted for the current unhealthy streak, mirrors Case SLA's slaAckBreachNotifiedAt pattern
}

model ConfigOperationLog {
  id            String   @id @default(uuid())
  workspaceSlug String
  operation     String
  stores        String[]
  actor         String
  createdAt     DateTime @default(now())
}
