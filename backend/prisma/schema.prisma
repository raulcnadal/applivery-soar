// Applivery SOAR — Prisma schema.
// Every model here maps onto one of the app's ~39 persisted store "kinds",
// or a durable-workflow table backing the workflow `wait` step.
//
// Tenancy: `workspaceSlug` is a plain column (not a separate schema-per-tenant)
// on every tenant-scoped model — every workspace's data lives in one shared
// Postgres instance.
// Models with no `workspaceSlug` are intentionally global (shared catalogs
// refreshed once for every workspace, mirroring the original app's "_global"
// pseudo-slug).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────────────────────────────────────────
// Auth / RBAC — no local user table (every "user" is an Applivery
// Collaborator); Role is the only thing we persist ourselves.
// ────────────────────────────────────────────────────────────────

model Role {
  id                 String   @id @default(uuid())
  workspaceSlug      String
  name               String
  description        String?
  featureAccess      Json // { devices: "none"|"read"|"manage", ... }
  riskyActions       Json // { canDeletePolicyOrWorkflow: bool, ... }
  appliveryTagValues String[]
  segmentIds         String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceSlug])
}

// Rewritten from a session-snapshot (apiToken/refreshToken pair) design to a
// single Applivery Service Account Bearer token (see
// https://docs.applivery.com/en/platform/api/service-accounts/). The original
// design took a snapshot of whichever admin's browser session was open when
// they clicked "Use this session for automation" and self-refreshed it in
// the background — but Applivery's own POST /auth/refresh rotates the
// refresh token on every call (confirmed against its OpenAPI spec: each
// response includes a fresh refreshToken.token, and a stale pair is
// rejected with 401 code 4011 "Last access token and refresh token
// invalid"). A live browser session proactively refreshing itself every
// ~60s (frontend/src/composables/useSessionGuards.ts) and this backend's own
// periodic refresh were two independent consumers racing to rotate the same
// shared token — whichever side refreshed first silently invalidated the
// other's copy, so the stored credential could go stale within one refresh
// cycle no matter how often an admin re-clicked "Use this session." Service
// Accounts have no refresh flow at all — a static, workspace-scoped Bearer
// token, exactly the mechanism Applivery's own docs recommend for "Workspace
// automation scripts" — which eliminates this whole class of race.
model AutomationCredential {
  workspaceSlug        String    @id
  serviceAccountToken  String // encrypted at rest — Applivery Service Account Bearer token
  configuredBy         String?
  configuredAt         DateTime?
  lastVerifiedAt       DateTime?
  updatedAt            DateTime  @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Workspace-level settings/state (today's single "state" JSON blob)
// ────────────────────────────────────────────────────────────────

model WorkspaceState {
  workspaceSlug                     String   @id
  // Opaque grid-layout blob ({widgets:[...], layout:[...]}) — the ACTUAL
  // Overview dashboard persistence mechanism (port of main.py's `dashboard`
  // StatePayload field). Note this is entirely separate from the
  // `WidgetLayout` model below, which backs the *other*, disused
  // `/api/layout` endpoint — the original frontend never calls that one;
  // every real dashboard save goes through POST /api/state's `dashboard`
  // field instead. Preserved as two separate mechanisms here for the same
  // reason: faithful port of a pre-existing quirk, not "fixed".
  dashboard                         Json?
  themeMode                         String?
  webhookUrl                        String?
  smtpConfig                        Json?
  scheduledReports                  Json?
  timezone                          String?
  customReportTemplate              String?  @db.Text
  auditLogRetentionDays             Int?
  sessionTimeoutMinutes             Int?
  installedAppsRefreshBudgetPerHour Int?
  // Same budget/rotation pattern as installedAppsRefreshBudgetPerHour, for
  // the geofencing location refresher (locationsRefresh.service.ts) — see
  // that file's doc comment for why location refresh needs its own,
  // separately-tunable budget rather than sharing the installed-apps one.
  locationRefreshBudgetPerHour       Int?
  // "Publish to Applivery" bookkeeping (agentBuilds.service.ts) — an
  // uploaded MDM asset (`mdm/assets`) whose *description* (not name — an
  // asset's name is meant to be human-facing, so it stays a clean
  // "Applivery SOAR Agent (Windows x64)" with no id in it) carries a
  // `[build:<version>]` token, where `<version>` is the exact AgentBuild
  // version (the git commit SHA the agent repo's CI tagged it with) — so a
  // repeat "Publish" click for a version that's already up there is
  // detected by subType+name lookup plus a description token match, and
  // halted as a no-op instead of creating a duplicate asset (that
  // per-click duplication, not a version bump, is what an admin was
  // seeing in Applivery's Assets list before this dedup check existed).
  // One application id per (platform, arch) variant — Windows x64 and
  // Windows ARM64 are two distinct Applivery-deployable applications (each
  // references exactly one asset/build), same as Windows and macOS always
  // were. Remembered so a later publish of a genuinely new version updates
  // the existing application in place via PUT instead of creating a
  // duplicate. Apple's enterprise-application API in particular has no
  // settable info.name to upsert-by-name against (confirmed against
  // Applivery's own OpenAPI schema), so this id is the only reliable
  // anchor for macOS; Windows could in principle upsert-by-name but uses
  // the same remembered-id pattern for consistency. Per-workspace, not
  // global, since each workspace's Applivery org is independent.
  windowsAmd64AgentApplicationId    String?
  windowsAmd64AgentPublishedAt      DateTime?
  windowsArm64AgentApplicationId    String?
  windowsArm64AgentPublishedAt      DateTime?
  macosAgentApplicationId           String?
  macosAgentPublishedAt             DateTime?
  // Event-driven detection (Phase 4 rollout controls) — see
  // backend/docs/event-driven-agent-detection-roadmap.md §4. Workspace-wide
  // kill switch: when false, GET /api/device-data/event-watches returns no
  // items regardless of individual EventWatchDefinition.enabled rows, so
  // every agent stops all watchers on its very next poll with no per-watch
  // cleanup needed. eventDrivenRemoteIntervalSec is the "IntervalSec
  // relaxation lever" from roadmap §2, made real: when set, it overrides
  // each device's local Managed Configuration IntervalSec value (the
  // Windows Agent picks it up from this same poll response and resets its
  // report ticker without a restart — telemetry_windows.go). Null means "no
  // override, defer to whatever's set in the registry on each device".
  eventDrivenDetectionEnabled       Boolean   @default(true)
  eventDrivenRemoteIntervalSec      Int?
  // mTLS agent authentication (Phase C — cutover). Off by default,
  // deliberately: unlike eventDrivenDetectionEnabled above, this is NOT a
  // safe-to-default-on convenience toggle — flipping it to true changes
  // what auth the 6 device-caller routes in deviceData.controller.ts
  // require. See backend/docs/mtls-agent-auth-roadmap.md §7's rollout
  // runbook: an admin only sets this once GET /api/mtls/certificates shows
  // full fleet coverage, and mtls.service.ts's setMtlsEnforcementEnabled
  // refuses to enable it at all if no CertificateAuthority is configured
  // yet (that would lock out the entire fleet with no way back in except
  // flipping this back off).
  mtlsEnforcementEnabled            Boolean   @default(false)
  // Bulk-purge (hard delete, not another revocation) of DeviceCertificate
  // rows already revoked more than certPurgeRetentionDays ago — a fleet with
  // real device churn (re-enrollments, replacements) accumulates revoked
  // rows indefinitely otherwise, since revoking one never deletes it (it's
  // kept for the audit trail / Revoked section). Off by default: purging is
  // irreversible, unlike every other retention knob in this file which only
  // trims logs/metrics. See certificates.service.ts's purgeRevokedCertificates
  // and jobs/backgroundJobs.ts's "mtls_cert_purge" job.
  certPurgeEnabled                  Boolean   @default(false)
  certPurgeRetentionDays            Int       @default(90)
  // Hostname only (e.g. "agents.soar.example.com"), no scheme, no path,
  // null until an admin sets one. Single source of truth for the dedicated
  // reverse-proxy vhost that carries the mTLS client-cert directives (see
  // backend/docs/mtls-agent-auth-roadmap.md §5.5) — TLS client-certificate
  // verification can't be scoped below server/vhost level, so this MUST be
  // a different domain than the dashboard's own. mtls.controller.ts's
  // Reverse Proxy Configuration panel is where an admin sets this;
  // Device Data Webhook's Managed Configuration bundle reads it back
  // read-only, so there is exactly one place to change it and every agent's
  // BaseURL derives from the same value.
  agentSubdomain                    String?
  // Which Applivery Smart Attribute (matched by NAME against
  // NormalizedDevice.smartAttributes[].name — see deviceNormalize.ts) holds
  // an OS patch-level value the customer has already populated on the
  // Applivery side: Android SPL date ("2026-05-05"), Apple dotted
  // version + build ("26.6.2 (25G82)"), Windows full build
  // ("10.0.28000.2704"). Configured once here (Settings > Workspace
  // Automation), then normalizeDeviceFull() reads it onto every device's
  // own osPatchLevel field at fetch time — so CVE-matching connectors
  // (osvAndroidService.ts, sofaService.ts) and Compliance Policy's
  // "OS Patch Level" condition (complianceFields.ts) never need to know
  // the attribute's name themselves, only that device.osPatchLevel may be
  // populated. Null/unset means no mapping configured — every consumer
  // falls back to its previous, coarser device.osVersion-based behavior.
  osPatchLevelSmartAttributeName    String?
  updatedAt                         DateTime  @updatedAt
}

// Per-notify-call observability row for event-driven detection (Phase 4
// metrics: webhook volume, debounce-collapse ratio, event-to-reaction
// latency) — written once per POST /api/device-data/event-notify call by
// deviceData.service.ts's handleEventNotify, regardless of outcome (status
// captures cooldown/unknown-watch/ok/error so volume reflects real inbound
// traffic, not just successful reactions). rawEventCount is the number of
// times the agent's local debouncer was bumped before this notify fired
// (null for pre-Phase-4 agent builds that don't send it yet) — averaging it
// across recent rows is the "debounce-collapse ratio" metric. latencyMs is
// server-received-at minus the agent's own clientTimestamp, when both are
// available. Rotated by rotateEventNotifyMetrics (backgroundJobs.ts) after
// METRIC_RETENTION_DAYS — this is an observability aid, not an audit trail,
// so it doesn't need AuditLog's configurable per-workspace retention.
model EventNotifyMetric {
  id            String   @id @default(uuid())
  workspaceSlug String
  watchKey      String
  action        String?
  status        String
  rawEventCount Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, createdAt])
}

model WidgetLayout {
  id            String   @id @default(uuid())
  workspaceSlug String
  userEmail     String
  layout        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceSlug, userEmail])
}

// ────────────────────────────────────────────────────────────────
// Compliance engine
// ────────────────────────────────────────────────────────────────

model CompliancePolicy {
  id                          String    @id @default(uuid())
  workspaceSlug               String
  name                        String
  description                 String?
  enabled                     Boolean   @default(true)
  autoRun                     Boolean   @default(false)
  severity                    String    @default("medium")
  conditionLogic               String    @default("any")
  conditions                  Json
  // Which platform (+ deployment model, where applicable) this policy's
  // conditions were authored for — same fields/semantics as Workflow's own
  // targetPlatform/targetDeploymentModel (App.jsx has no equivalent; this
  // is a disclosed addition, not a parity port). Nullable for backward
  // compatibility: every policy that existed before this column was added
  // keeps evaluating against every platform exactly as before (see
  // compliance.service.ts's scopedDevices filter, which only narrows by
  // platform when this is set). targetDeploymentModel is builder-guidance
  // only (narrows which condition fields/attribute-name hints are shown) --
  // unlike targetPlatform, it is NOT enforced against real device data
  // during evaluation, because Applivery never reports a device's actual
  // deployment model (supervised/work profile/COPE/etc.) as live telemetry
  // -- the same limitation Workflow's own targetDeploymentModel already has
  // (mdmActionExecutor.ts's own comment: "the WORKFLOW's own declared
  // deployment model ... not something read off the real device").
  targetPlatform               String?
  targetDeploymentModel         String?
  workflowId                  String?
  nonComplianceTag             String?
  nonComplianceSmartAttributeId String?
  openCaseOnViolation          Boolean   @default(true)
  autoResolveCaseOnRecovery     Boolean   @default(false)
  // Optional default assignee auto-set on every Case this policy opens (or
  // reopens) — purely a convenience default, still freely reassignable
  // afterward from the Cases view like any other case. Null/empty means
  // "leave unassigned," the pre-existing behavior.
  caseAssignee                String?
  mitreTechniques              String[]
  framework                   String?
  controlRef                  String?
  targetDeviceAudienceId        String?
  // Administrative/visibility scope only (docs/compliance.md: "does not
  // filter which devices get checked") — which Segment owns this policy,
  // used to scope the Policies list to whatever Segment is selected in the
  // Segments panel (PolicyBuilder.jsx segmentId / CompliancePoliciesView.jsx
  // collectSegmentIds). Bare string column, no relation — matches
  // Case.segmentId's pattern, since Segments aren't a local Prisma model
  // (fetched live from Applivery).
  segmentId                   String?
  evaluationIntervalMinutes    Int       @default(60)
  autoRunBatchCap              Int?      @default(15)
  autoRunDestructiveAck         Boolean   @default(false)
  escalatedWorkflowId          String?
  escalatedWorkflowMinRiskTier  String    @default("high")
  // Violation alerting — a rolled-up (not per-device) notification fired
  // once per evaluation pass when this policy finds at least one NEW
  // violation, independent of autoRun/workflow config. alertWebhookUrl
  // overrides Settings > General's single global "Notifications Webhook
  // URL" when set (falls back to it when null/blank); alertEmailRecipients
  // is this policy's own list, independent of Settings > SMTP's global
  // "Alert Email Recipients" (used for SLA breach/System Health instead).
  // lastAlertSentAt/lastAlertError mirror Integration.lastFiredAt/lastError
  // so a misconfigured webhook/recipient list is visible, not a silent
  // no-op — see compliance.service.ts's firePolicyViolationAlert.
  alertOnViolation             Boolean   @default(false)
  alertViaWebhook              Boolean   @default(false)
  alertViaEmail                Boolean   @default(false)
  alertWebhookUrl              String?
  alertEmailRecipients         String?
  lastAlertSentAt              DateTime?
  lastAlertError               String?
  // Optional per-channel daily send caps — a guardrail against a
  // misconfigured or overly broad policy flooding a webhook/inbox with
  // alerts (each evaluation pass that finds a new violation fires one
  // alert per enabled channel, so a policy re-tripping every interval can
  // otherwise send unboundedly). Null/unset means unlimited, matching every
  // other optional Int? column here (e.g. autoRunBatchCap) — each channel
  // is capped independently, so e.g. Webhook can stay unlimited while Email
  // is capped, or vice versa. alertWebhookSentToday/alertEmailSentToday are
  // the running counts for alertCountersDate (a "YYYY-MM-DD" day key, same
  // convention as AnalyticsSnapshot/widgets.service.ts); firePolicyViolationAlert
  // resets both counts to 0 whenever today's date key no longer matches.
  alertWebhookMaxPerDay        Int?
  alertEmailMaxPerDay          Int?
  alertWebhookSentToday        Int       @default(0)
  alertEmailSentToday          Int       @default(0)
  alertCountersDate            String?
  // Scheduler/circuit-breaker state — not part of the save payload, managed
  // by the evaluation engine itself (see CompliancePolicyPayload comments
  // in compliance.schemas.ts). An explicit save resets the trip, same as
  // the original's update_compliance_policy.
  lastEvaluatedAt              DateTime?
  autoRunTripped               Boolean   @default(false)
  autoRunTrippedAt             DateTime?
  autoRunTrippedReason         String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  violations ComplianceViolation[]

  @@index([workspaceSlug])
}

model ComplianceViolation {
  id                String    @id @default(uuid())
  workspaceSlug     String
  policyId          String
  policy            CompliancePolicy @relation(fields: [policyId], references: [id])
  policyName        String?
  workflowId        String?
  workflowName      String?
  workflowRunId     String?
  escalated         Boolean   @default(false)
  deviceId          String
  deviceName        String?
  platform          String?
  platformDeviceId  String?
  matchedConditions Json?
  caseId            String?
  status            String
  severity          String    @default("medium")
  detectedAt        DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([workspaceSlug, policyId])
  @@index([workspaceSlug, status])
}

// Port of `_load_policy_quarantine`/`_save_policy_quarantine`'s per-workspace
// dict, keyed by deviceId -> {platform, policies, snapshotAt, workflowId}
// (main.py:6653 `_snapshot_policies_if_needed`). One row per (workspaceSlug,
// deviceId) — a later escalation tier touching an already-quarantined device
// must never clobber the original pre-quarantine baseline, so writes are a
// create-if-absent, not an upsert-overwrite.
model PolicyQuarantineEntry {
  id            String   @id @default(uuid())
  workspaceSlug String
  deviceId      String
  platform      String?
  policies      Json // snapshot of activePolicies at quarantine time — [{id, name, ...}]
  workflowId    String?
  snapshotAt    DateTime @default(now())

  @@unique([workspaceSlug, deviceId])
}

// Per-workspace suppression map — port of the original's `_compliance_state`
// JSON file. Keyed `"{policyId}:{deviceId}"` -> {violationId, status,
// lastDetectedAt}; a key's presence is what stops a still-violating
// device/policy pair from spawning a duplicate violation record on every
// evaluation pass. Cleared only on recovery (see compliance.service.ts),
// NOT by approving/dismissing a violation — matches the original's
// behavior of the two being fully independent (state suppresses;
// violation.status just reflects triage).
model ComplianceEvaluationState {
  workspaceSlug String @id
  state         Json   @default("{}")
}

// ────────────────────────────────────────────────────────────────
// Workflows — two execution engines, same schema
// ────────────────────────────────────────────────────────────────

model Workflow {
  id                         String   @id @default(uuid())
  workspaceSlug              String
  name                       String
  description                String?
  steps                      Json
  targetPlatform             String?
  targetDeploymentModel      String?
  recovery                   Json
  allowUnattendedDestructive Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  versions WorkflowVersion[]

  @@index([workspaceSlug])
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reason     String // 'update' | 'restore'
  createdBy  String?
  snapshot   Json // { name, description, steps, targetPlatform, targetDeploymentModel, recovery }
  createdAt  DateTime @default(now())

  @@index([workflowId])
}

model WorkflowRun {
  id                String    @id @default(uuid())
  workspaceSlug     String
  workflowId        String
  // `workflowName`/`total` are set at launch time for BOTH engines (Phase 4b
  // addition); `log` is only populated once the run is fully done — a live
  // "waiting"/"running" durable run is instead reconstructed on read from
  // the `results` relation (see workflows.service.ts's runView-equivalent,
  // porting main.py's `_pg_run_view`). This keeps the pre-existing in-memory
  // engine's write-once-at-completion behavior (Phase 4a) completely
  // unchanged: it still just writes `log` once and never touches
  // total/workflowName in the meantime.
  workflowName      String?
  targetDescription String?
  status            String
  total             Int?
  log               Json?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  pendingSteps WorkflowPendingStep[]
  results      WorkflowRunResult[]

  @@index([workspaceSlug, workflowId])
}

/**
 * Port of Postgres table `workflow_pending_steps` (main.py:501-536) — one row
 * per device currently parked in a 'wait' or 'run_script_wait' step, with
 * everything needed to resume it. `stepKind` 'timer' is a plain 'wait'
 * (resumeAt is exactly when to fire, always down nextStepId). 'script' is a
 * 'run_script_wait' (resumeAt is a TIMEOUT safety net — the fast path is
 * script_log_reconciler_loop resolving `pendingToken` early and deleting this
 * row itself; if the timer-based resumer claims a 'script' row instead, that
 * always means "timed out", so it follows onFailureStepId, never nextStepId).
 */
model WorkflowPendingStep {
  id              String    @id @default(uuid())
  runId           String
  run             WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceSnapshot  Json
  workflowId      String
  slugKey         String
  nextStepId      String
  log             Json
  resumeAt        DateTime
  stepKind        String    @default("timer") // 'timer' | 'script'
  onFailureStepId String?
  pendingToken    String?   @unique
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([resumeAt])
  @@index([runId])
}

/**
 * Port of Postgres table `workflow_run_results` (main.py:488-499) — one row
 * PER DEVICE in a run (not per-step; `steps` holds that device's full log so
 * far as one JSON array), upserted via ON CONFLICT (runId, deviceId). `status`
 * is 'waiting' | 'done'; `finalStatus` ('success'|'partial'|'failed') is only
 * set once `status` is 'done'.
 */
model WorkflowRunResult {
  id          String   @id @default(uuid())
  runId       String
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceName  String?
  steps       Json
  status      String // 'waiting' | 'done'
  finalStatus String?
  updatedAt   DateTime @updatedAt

  @@unique([runId, deviceId])
  @@index([runId])
}

// ────────────────────────────────────────────────────────────────
// Triggers, Cases, Case automation
// ────────────────────────────────────────────────────────────────

model Trigger {
  id                String    @id @default(uuid())
  workspaceSlug     String
  name              String
  description       String?
  workflowId        String
  enabled           Boolean   @default(true)
  openCase          Boolean   @default(false)
  caseSeverity      String    @default("medium")
  deviceLookupField String?
  secret            String
  lastFiredAt       DateTime?
  fireCount         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceSlug])
}

// Per-(Trigger, device) firing state — Trigger's own lastFiredAt/fireCount
// above are workspace-wide aggregates across every device that has ever hit
// that inbound webhook, which can't answer "did THIS device's EDR/MTD/DEX
// tool call this webhook (and when)". This table backs exactly that,
// written inside fireTrigger/resolveTrigger (triggers.service.ts) each time
// a fire/resolve resolves to a real device, and read by deviceNormalize.ts
// to attach onto NormalizedDevice.triggerFires for the Compliance Policy
// Builder's "Inbound Webhook Fired" condition (complianceFields.ts's
// triggerFired field / complianceEvaluate.ts's evaluator) to read from.
//
// status/resolvedAt exist because a raw "did it ever fire" flag can't tell
// a still-active EDR/MTD/DEX alert apart from one the same external tool
// already cleared -- an admin flagged exactly this: SOAR could move a
// device out of compliance off an inbound Trigger firing, but had no way
// to hear back that the condition causing it was no longer happening,
// leaving the device stuck out of compliance forever. Each configured
// Trigger now exposes two URLs (triggers.controller.ts) -- .../fire/...
// sets status="active" (existing behavior), .../resolve/... (new) sets
// status="resolved" -- so the SAME external system that raised the alert
// is expected to call the resolve URL once its own condition clears.
// complianceEvaluate.ts's "exists" operator only reports true while
// status is "active", so a Compliance Policy built on this condition
// recovers automatically (tag/case cleanup, same as any other condition)
// the moment a resolve comes in and nothing else in the policy still
// matches. lastPayload is kept purely for admin visibility — never read
// by the evaluator.
model TriggerFireState {
  id            String    @id @default(uuid())
  workspaceSlug String
  triggerId     String
  deviceId      String
  status        String    @default("active") // "active" | "resolved"
  lastFiredAt   DateTime
  resolvedAt    DateTime?
  fireCount     Int       @default(1)
  lastPayload   Json?
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceSlug, triggerId, deviceId])
  @@index([workspaceSlug, deviceId])
}

// The incident layer above raw Compliance Violations — port of main.py's
// CASE MANAGEMENT section (main.py:11779-12360ish). A Case survives across
// repeated detections of the same underlying problem and carries its own
// investigative status independent of whether remediation already ran.
// Three sources: 'compliance_violation' (auto-opened by
// upsertCaseForViolation), 'workflow_trigger' (opened by fireTrigger when
// openCase=true), 'manual' (POST /api/cases).
model Case {
  id             String  @id @default(uuid())
  workspaceSlug  String
  title          String
  status         String  @default("open") // open | investigating | resolved | closed | false_positive
  severity       String  @default("medium")
  source         String // compliance_violation | workflow_trigger | manual
  deviceId       String?
  deviceName     String?
  segmentId      String?
  policyId       String?
  policyName     String?
  violationIds   String[] @default([])
  workflowRunIds String[] @default([])
  assignee       String?
  createdBy      String?
  closedAt       DateTime?
  // SLA tracking — see CaseSlaSettings/_case_sla_status. acknowledgedAt is
  // set the first time a case gets an assignee OR moves to 'investigating'.
  // slaClockStartedAt anchors the SLA window and resets on every reopen
  // (recurrence is a fresh incident from an SLA standpoint); createdAt never
  // changes, preserving the case's original open date for history.
  acknowledgedAt             DateTime?
  slaClockStartedAt          DateTime  @default(now())
  slaAckBreachNotifiedAt     DateTime?
  slaResolveBreachNotifiedAt DateTime?
  mitreTechniques String[] @default([])
  // Threat intel lookups run against IOCs on this case (see
  // POST /api/cases/{id}/enrich) — array of {id,ioc,iocType,provider,
