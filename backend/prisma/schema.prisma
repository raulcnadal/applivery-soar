// reputation check, not a CPE/version CVE match. Keyed by (workspaceSlug,
// sha256) alone, NOT the `${identifier}|${version}|${platform}` scheme the
// vuln sources share — the same binary hash can be shared by many
// identifier/version combos across the fleet (or, if tampered, a device's
// copy can differ from every other device's "same" app — which is exactly
// the signal this exists to catch), so hash is the only meaningful key.
// Reuses the workspace's existing VirusTotal ThreatIntelProvider config —
// no separate connector/API-key UI for this (see binaryIntegrityService.ts).
model BinaryIntegrityConfig {
  workspaceSlug        String    @id
  refreshIntervalHours Int       @default(24)
