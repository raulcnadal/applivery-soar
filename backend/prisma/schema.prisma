// Per-device latest known position, kept fresh by the budgeted background
// refresher (locationsRefresh.service.ts/locationJobs.ts) — deliberately NOT
// a history table. Applivery's own /mdm/locations/{type}/{id} endpoint
// already retains full history and DeviceInsightModal.vue already fetches
// it live, on-demand, per device when an admin opens one — duplicating that
// history locally would be pure storage cost for a need this app doesn't
// have. This table exists purely so geofence "inside"/"outside" conditions
// have a fast, no-API-call point to evaluate against for every device on
// every Compliance Policy evaluation pass, and so the refresher can rank
// "which device is most overdue for a refresh" without re-deriving that
// from `LocationCache`'s single-blob-for-the-whole-fleet shape (which has
// no per-device staleness of its own). Separate from LocationCache
// (Playground globe's data source, populated by the pre-existing manual
// "Sync Locations" button) by design — different freshness needs, different
// callers; see locationsRefresh.service.ts's doc comment for the full
// rationale on why these two caches are intentionally not unified.
model DeviceLocation {
  id            String    @id @default(uuid())
  workspaceSlug String
  deviceId      String
  lat           Float
  lng           Float
  source        String? // "agent" | "ip", straight from Applivery's own `origin`
  recordedAt    DateTime? // the location fix's own timestamp, per Applivery
  fetchedAt     DateTime // when THIS app last pulled it
  error         String?

  @@unique([workspaceSlug, deviceId])
  @@index([workspaceSlug, fetchedAt])
}

model AnalyticsSnapshot {
  id            String   @id @default(uuid())
  workspaceSlug String
  source        String
  date          String
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([workspaceSlug, date, source])
}

// ────────────────────────────────────────────────────────────────
// Audit logging, log export, system health, config export
// ────────────────────────────────────────────────────────────────

model AuditLogEntry {
  id            String   @id @default(uuid())
  workspaceSlug String
  category      String
  action        String
  actor         String
  targetType    String?
  targetId      String?
  targetName    String?
  message       String   @db.Text
  severity      String   @default("info")
  createdAt     DateTime @default(now())

  @@index([workspaceSlug, createdAt])
}

model LogExportDestination {
  id              String    @id @default(uuid())
  workspaceSlug   String
  type            String
  name            String
  enabled         Boolean   @default(true)
  format          String    @default("json")
  config          Json // secret sub-fields (secretAccessKey/password/privateKeyPassphrase) encrypted at rest — see logExportDestinations.service.ts
  createdBy       String?
  // Batch types only (s3/nfs/sftp) — cursor + last-failure tracking for
  // log_export_scheduler_loop's once-a-day ship. Real-time types
  // (syslog/webhook) never touch these, they fire inline per audit write.
  lastExportedAt  DateTime?
  lastExportError String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceSlug])
}

model SystemHealthJob {
  jobKey            String    @id
  status            String
  detail            String?
  lastHeartbeatAt   DateTime  @default(now())
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  consecutiveErrors Int       @default(0)
  lastAlertSentAt   DateTime? // non-null == already alerted for the current unhealthy streak, mirrors Case SLA's slaAckBreachNotifiedAt pattern
}

model ConfigOperationLog {
  id            String   @id @default(uuid())
  workspaceSlug String
  operation     String
  stores        String[]
  actor         String
  createdAt     DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────
// mTLS agent authentication (Phase A — backend PKI foundation).
// See backend/docs/mtls-agent-auth-roadmap.md for the full design.
// Additive only: nothing here is consulted by the existing
// verifyDeviceReportSecret auth path yet.
// ────────────────────────────────────────────────────────────────

model CertificateAuthority {
  workspaceSlug    String   @id
  certPem          String   @db.Text // CA public certificate, PEM — safe to expose to admins/agents
  privateKeyPem    String   @db.Text // encrypted at rest via secretCipher
  keyAlgorithm     String // "ECDSA-P256"
  source           String // "generated" | "uploaded"
  serialCounter    Int      @default(1) // next leaf-cert serial to issue, monotonically increasing
  leafValidityDays Int      @default(90) // admin-configurable; service layer enforces a 47-day floor
  notBefore        DateTime
  notAfter         DateTime
  uploadedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DeviceCertificate {
  id            String    @id @default(uuid())
  workspaceSlug String
  serialNumber  String // device identity (matches Applivery's own device serial), the cert's CN
  serialHex     String // the certificate's OWN X.509 serial number (hex) — distinct from serialNumber above; what revocation/CRL checks key on
  certPem       String    @db.Text // issued certificate, public only — the private key never leaves the device
  // SHA-256 thumbprint, plain uppercase hex with no colon separators — kept
  // display-format-free specifically so it's cheaply searchable with a plain
  // `contains` (certificates.service.ts's listCertificates normalizes a
  // pasted "AB:12:..."-style search term the same way before querying).
  // Colons are re-added only at the API/display layer (mtlsPki.ts's
  // formatThumbprint). Nullable + backfilled lazily on read for rows issued
  // before this column existed, rather than a data migration — see
  // listCertificates's own doc comment.
  thumbprintHex String?
  notBefore     DateTime
  notAfter      DateTime
  supersededAt  DateTime? // set when a renewal issues a newer cert for the same serialNumber
  revokedAt     DateTime?
  revokedReason String?
  issuedAt      DateTime  @default(now())
  // Stamped (fire-and-forget, best-effort) on every successful mTLS-gated
  // request this certificate authenticates — see
  // certificates.service.ts's touchCertificateLastSeen and
  // mtlsIdentity.middleware.ts's assertMtlsIdentity, which calls it right
  // after a cert passes verification. Exists so the Devices list's "SOAR
  // Agent" column has a real signal for mTLS-only callers (the mobile app,
  // which never POSTs a DevicePushData report — see
  // devices.service.ts's soarAgentReporting computation, which now treats
  // "presented a valid client cert recently" as equivalent evidence of a
  // live agent to "posted a report recently"). Nullable: null until the
  // very first authenticated request after this column existed / after a
  // fresh enrollment.
  lastSeenAt    DateTime?

  @@unique([workspaceSlug, serialHex])
  @@index([workspaceSlug, serialNumber])
  // Backs the Active/Revoked section split and their counts in the Issued
  // Device Certificates panel, and the bulk purge-old-revoked-certs query —
  // all filter on (workspaceSlug, revokedAt) at fleet scale (thousands of
  // rows), so this needs its own index rather than relying on the
  // serialNumber one above.
  @@index([workspaceSlug, revokedAt])
}

/**
 * The single, workspace-wide mTLS enrollment credential (superseded both
 * DeviceBootstrapToken's per-device one-time tokens and the Phase E
 * "EnrollmentSecret" self-service addendum this table used to be — same
 * columns, renamed table, existing data preserved by the migration). One
 * value, deployed once via a single Managed Configuration push to the whole
 * fleet (see registry_windows.go's BootstrapToken field / README). A device
 * proves it's allowed to enroll with this token PLUS a live check that its
 * claimed serial number is currently a known, enrolled device in this
 * workspace's Applivery UEM fleet (deviceMtls.service.ts's
 * assertKnownApplivertyDevice) — always issued immediately on success, no
 * admin approval step (classic bootstrap-token semantics: unattended by
 * design). A serial number that already has an active certificate can never
 * be silently re-claimed (assertNotAlreadyActive) — the worst a leaked token
 * enables is claiming a not-yet-enrolled device before its real owner does.
 * Encrypted at rest (secretCipher), same treatment as DeviceReportSecret.
 */
model GlobalBootstrapToken {
  workspaceSlug String   @id
  secret        String
  rotatedBy     String?
  updatedAt     DateTime @updatedAt
}

/**
 * Per-workspace Google Play Integrity API configuration — Settings > Google
 * Play Integrity API. Admin-provided rather than hardcoded (mobile telemetry
 * roadmap Phase 3, playIntegrity.service.ts) since each workspace's Android
 * app is its own distinct GCP-linked Play Console listing, with its own
 * Cloud Project number and its own downloaded offline-decryption key pair.
 *
 * `decryptionKey` is the AES symmetric key (JWE key-wrapping, A256KW) —
 * encrypted at rest (secretCipher), same treatment as
 * AutomationCredential.serviceAccountToken/GlobalBootstrapToken.secret above.
 * `verificationKey` is the DER-encoded EC public key (JWS signature
 * verification, ES256) — NOT secret (it's a public key), stored as provided,
 * base64-encoded exactly as downloaded from Play Console, but versioned
 * alongside `decryptionKey` since Google issues both as one pair and they
 * must always be used together. `cloudProjectNumber` also isn't secret (the
 * user's own GCP Project Number, sent to the Android client so it can
 * request a Classic API integrity token — see IntegrityTokenRequest's own
 * setCloudProjectNumber requirement for apps distributed outside Google
 * Play's own linked-project flow).
 */
model PlayIntegrityConfig {
  workspaceSlug      String    @id
  cloudProjectNumber String
  decryptionKey      String // encrypted at rest — base64 AES key from Play Console
  verificationKey    String // base64 DER-encoded EC public key from Play Console, not secret
  enabled            Boolean   @default(true)
  configuredBy       String?
  configuredAt       DateTime?
  updatedAt          DateTime  @updatedAt
}

/**
 * One issued, single-use Play Integrity `nonce` — see playIntegrity.service.ts's
 * issueNonce/verifyAndDecodeToken doc comments for the full replay-protection
 * design Google's own docs mandate (developer.android.com/google/play/integrity/classic#nonce):
 * a nonce must be unpredictable, checked for a first-time use, and expired
 * after a short window. Deliberately its own table rather than reusing
 * DevicePushData — this is short-lived security-protocol state, not device
 * telemetry, and needs its own uniqueness/expiry semantics.
 */
model PlayIntegrityNonce {
  id            String    @id @default(cuid())
  workspaceSlug String
  serialNumber  String
  nonce         String    @unique
  issuedAt      DateTime  @default(now())
  consumedAt    DateTime?

  @@index([workspaceSlug, serialNumber])
}
