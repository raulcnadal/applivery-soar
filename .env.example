# Copy this file to .env and fill in real values. See README.md "Environment
# variables" for what each one does. Do not commit the filled-in .env file —
# it will contain real secrets.

DASHBOARD_SECRET=
POSTGRES_PASSWORD=

# Optional — only needed if you want automated compliance evaluation, daily
# snapshots, scheduled report delivery, and resuming workflow 'wait' steps
# to run without a human logged in, and prefer a single env-var fallback
# over configuring a credential per workspace under Settings > Workspace
# Automation.
# AUTOMATION_ORG_SLUG=
# AUTOMATION_API_TOKEN=

# Optional — only needed if you wire up an external trigger (e.g. a
# Cloudflare Worker Cron Trigger) calling POST /api/workflows/resume-due or
# POST /api/compliance/evaluate-due over HTTP.
# TRIGGER_SECRET=
